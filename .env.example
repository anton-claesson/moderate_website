# Mapbox GL JS public token (required for F2.1)
# Get one at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase project (required for contact form)
# Create a free project at https://supabase.com (region: Frankfurt), run the SQL in the plan, then copy these from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
